{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    },
    {
      "src": "assessment.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assessments/?",
      "dest": "assessment.html"
    },
    {
      "src": "/(.*)",
      "dest": "index.py"
    }
  ]
}
